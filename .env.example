# Gemini API Key for AI Travel Companion features (Server-Side)
# AI Studio automatically injects this at runtime from secrets.
# For local VS Code development, get a free API key at https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Server Port (default: 3000)
PORT=3000

# Application Base URL
APP_URL="http://localhost:3000"
